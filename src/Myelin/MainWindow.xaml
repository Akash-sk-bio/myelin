<Window x:Class="Myelin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Myelin"
        Title="Myelin" Width="1160" Height="740" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource TextFont}" FontSize="13.5" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Section}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,18,0,10"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="2"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- ═════════ toolbar ═════════ -->
        <Grid Margin="20,0,20,0">
            <StackPanel x:Name="Lights" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="CloseBtn" Style="{StaticResource Light}" Background="#FF5F57" Foreground="#8C1A10" Tag="{StaticResource GlyphClose}" ToolTip="Close (keeps running in the tray)"/>
                <Button x:Name="MinBtn" Style="{StaticResource Light}" Background="#FEBC2E" Foreground="#985712" Tag="{StaticResource GlyphMin}" ToolTip="Minimize"/>
                <Button x:Name="ZoomBtn" Style="{StaticResource Light}" Background="#28C840" Foreground="#0A6513" Tag="{StaticResource GlyphZoom}" ToolTip="Zoom"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image x:Name="LogoImg" Width="20" Height="20"/>
                <TextBlock Text="Myelin" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource TertiaryBrush}"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,14,0"/>
                <Button x:Name="ApplyBtn" Style="{StaticResource Primary}" Content="Apply" Padding="16,5"/>
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="Progress" Grid.Row="1" Style="{StaticResource Thin}" Maximum="100" Visibility="Hidden"/>

        <!-- ═════════ body ═════════ -->
        <Grid x:Name="Body" Grid.Row="2" Margin="20,6,20,20" MaxWidth="1400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*" MinWidth="440" MaxWidth="560"/>
            </Grid.ColumnDefinitions>

            <!-- left: compact live stage + the pointer set -->
            <Grid MaxWidth="780" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="Stage" Height="330" CornerRadius="18" Background="{DynamicResource StageBrush}" ClipToBounds="True">
                    <Grid>
                        <local:FxDemo x:Name="StageDemo"/>
                        <StackPanel Margin="22,18,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                            <TextBlock x:Name="StageTitle" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="22" Foreground="#F5F5F7"/>
                            <TextBlock x:Name="StageSub" FontSize="12.5" Foreground="#8E8E93" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="StageToggle" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Cursor="Hand"
                                ToolTip="Preview on a dark or light background">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Width="30" Height="30" CornerRadius="15" Background="{TemplateBinding Background}">
                                        <TextBlock Text="&#xE793;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="Your real pointer has these effects everywhere." FontSize="11.5" Foreground="#8E8E93"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,14" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Border x:Name="Shelf" Grid.Row="1" Margin="0,14,0,0" CornerRadius="16" Padding="10,10,10,6" Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <UniformGrid x:Name="ShelfGrid" Columns="8"/>
                        <Button x:Name="ShelfToggle" Style="{StaticResource Link}" HorizontalAlignment="Center" Margin="0,4,0,2" FontSize="12" Content="Show all 17 pointers"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- right: tabs instead of one long scroll -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Display}" FontSize="28" Text="Your pointer."/>
                    <Border Style="{StaticResource SegHost}" Margin="0,14,0,4">
                        <UniformGrid Columns="4">
                            <RadioButton x:Name="TabLook" GroupName="tabs" Style="{StaticResource Segment}" Content="Look" IsChecked="True"/>
                            <RadioButton x:Name="TabStyle" GroupName="tabs" Style="{StaticResource Segment}" Content="Style"/>
                            <RadioButton x:Name="TabEffects" GroupName="tabs" Style="{StaticResource Segment}" Content="Effects"/>
                            <RadioButton x:Name="TabSettings" GroupName="tabs" Style="{StaticResource Segment}" Content="Settings"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <ScrollViewer x:Name="Options" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,4,6,8">

                        <!-- LOOK -->
                        <StackPanel x:Name="PanelLook">
                            <TextBlock Style="{StaticResource Head}"><Run Text="Start with a look."/><Run Text=" Then make it yours." Foreground="{DynamicResource SecondaryBrush}"/></TextBlock>
                            <StackPanel x:Name="Looks"/>
                            <TextBlock Style="{StaticResource Secondary}" Margin="2,6,0,0" FontSize="12.5"
                                       Text="Each look sets the colour, material and effects together. Fine-tune any of them in Style and Effects."/>
                        </StackPanel>

                        <!-- STYLE -->
                        <StackPanel x:Name="PanelStyle" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Head}" Text="Color"/>
                            <WrapPanel x:Name="Tints"/>
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,6,0,8" Text="Highlight · heartbeat light, badges and sparks"/>
                            <WrapPanel x:Name="Highlights"/>

                            <TextBlock Style="{StaticResource Head}" Text="Material"/>
                            <Border Style="{StaticResource SegHost}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="MatClear" GroupName="mat" Style="{StaticResource Segment}" Content="Clear glass" Width="120"/>
                                    <RadioButton x:Name="MatTinted" GroupName="mat" Style="{StaticResource Segment}" Content="Tinted glass" Width="120"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="MaterialNote" Style="{StaticResource Secondary}" FontSize="12.5" Margin="2,8,0,0" Visibility="Collapsed"
                                       Text="In the light theme your pointers are solid for clarity on white. Glass returns in the dark theme."/>

                            <TextBlock Style="{StaticResource Head}" Text="Motion"/>
                            <Border Style="{StaticResource SegHost}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="MotFull" GroupName="mot" Style="{StaticResource Segment}" Content="Full" Width="92"/>
                                    <RadioButton x:Name="MotSubtle" GroupName="mot" Style="{StaticResource Segment}" Content="Subtle" Width="92"/>
                                    <RadioButton x:Name="MotStill" GroupName="mot" Style="{StaticResource Segment}" Content="Still" Width="92"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- EFFECTS -->
                        <StackPanel x:Name="PanelEffects" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Head}" Text="Trail"/>
                            <UniformGrid x:Name="TrailGrid" Columns="3"/>

                            <TextBlock Style="{StaticResource Head}" Text="Clicks"/>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Width="44" Style="{StaticResource Secondary}" FontSize="12.5" VerticalAlignment="Top" Margin="0,7,0,0" Text="Left"/>
                                <WrapPanel x:Name="LeftChips"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Width="44" Style="{StaticResource Secondary}" FontSize="12.5" VerticalAlignment="Top" Margin="0,7,0,0" Text="Right"/>
                                <WrapPanel x:Name="RightChips"/>
                            </DockPanel>

                            <TextBlock Style="{StaticResource Head}" Text="Extras"/>
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}" MinHeight="40" Padding="0,8"><CheckBox x:Name="FerroSwitch" Style="{StaticResource Switch}"><TextBlock Text="Ferrocene molecules on the comet"/></CheckBox></Border>
                                    <Border Style="{StaticResource Row}" MinHeight="40" Padding="0,8"><CheckBox x:Name="DblSwitch" Style="{StaticResource Switch}"><TextBlock Text="Double-click mitosis"/></CheckBox></Border>
                                    <Border Style="{StaticResource Row}" MinHeight="40" Padding="0,8"><CheckBox x:Name="DragSwitch" Style="{StaticResource Switch}"><TextBlock Text="Drag tether"/></CheckBox></Border>
                                    <Border Style="{StaticResource Row}" MinHeight="40" Padding="0,8"><CheckBox x:Name="IdleSwitch" Style="{StaticResource Switch}"><TextBlock Text="Idle orbit"/></CheckBox></Border>
                                    <Border Style="{StaticResource RowLast}" MinHeight="40" Padding="0,6">
                                        <DockPanel>
                                            <Slider x:Name="EnergySlider" DockPanel.Dock="Right" Width="170" Style="{StaticResource Neo}" Minimum="20" Maximum="160" VerticalAlignment="Center"/>
                                            <TextBlock Text="Energy" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- SETTINGS -->
                        <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                            <Border Style="{StaticResource Group}" Margin="0,18,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}" MinHeight="42" Padding="0,9">
                                        <CheckBox x:Name="FxSwitch" Style="{StaticResource Switch}"><TextBlock Text="Effects  ·  Ctrl+Alt+E"/></CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource Row}" MinHeight="42" Padding="0,9">
                                        <CheckBox x:Name="LiveSwitch" Style="{StaticResource Switch}"><TextBlock Text="Live updates to your real pointer"/></CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource Row}" MinHeight="42" Padding="0,7">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource SegHost}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="ThemeSystem" GroupName="theme" Style="{StaticResource Segment}" Content="Auto"/>
                                                    <RadioButton x:Name="ThemeLight" GroupName="theme" Style="{StaticResource Segment}" Content="Light"/>
                                                    <RadioButton x:Name="ThemeDark" GroupName="theme" Style="{StaticResource Segment}" Content="Dark"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}" MinHeight="42" Padding="0,9">
                                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}"><TextBlock Text="Open at sign-in"/></CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource RowLast}" MinHeight="42" Padding="0,9">
                                        <CheckBox x:Name="FsSwitch" Style="{StaticResource Switch}"><TextBlock Text="Pause effects in fullscreen games"/></CheckBox>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="ExportBtn" Style="{StaticResource Pill}" Content="Export pack…" Margin="0,0,8,8"/>
                                <Button x:Name="RestoreBtn" Style="{StaticResource Pill}" Content="Restore Windows pointers" Margin="0,0,8,8"/>
                                <Button x:Name="ResetBtn" Style="{StaticResource Pill}" Content="Reset" Margin="0,0,8,8"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                <Image x:Name="FootLogo" Width="36" Height="36"/>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Myelin" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,10,0,0"
                                       Text="Designed by Akash Sk · Akash Bio AI. MIT License. No telemetry; everything stays on this PC."/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="InstaBtn" Style="{StaticResource Link}" Content="Instagram" Margin="0,0,18,0"/>
                                <Button x:Name="GithubBtn" Style="{StaticResource Link}" Content="GitHub"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
